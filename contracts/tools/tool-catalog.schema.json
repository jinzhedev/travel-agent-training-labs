{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.local/contracts/tools/tool-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_id", "revision", "source", "observed_at", "valid_until", "is_simulated", "notice", "tools"],
  "properties": {
    "catalog_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "const": "tool-catalog-v1.5"},
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "is_simulated": {"type": "boolean", "const": true},
    "notice": {"type": "string", "minLength": 1},
    "tools": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/tool"}}
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "namespace", "summary", "use_when", "avoid_when", "keywords", "permissions", "risk_level", "side_effect", "requires_confirmation", "latency_class", "environments", "input_schema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
        "version": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "use_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "avoid_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "risk_level": {"enum": ["low", "medium", "high"]},
        "side_effect": {"enum": ["none", "persistent", "external"]},
        "requires_confirmation": {"type": "boolean"},
        "latency_class": {"enum": ["fast", "medium", "slow"]},
        "environments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "input_schema": {"type": "object"}
      }
    }
  }
}
