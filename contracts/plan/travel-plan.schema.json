{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://training.example/contracts/travel-plan.schema.json",
  "title": "TravelPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "destination",
    "days",
    "estimated_total_cost_cny",
    "assumptions",
    "unresolved_questions"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "theme", "items"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "theme": {"type": "string"},
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "poi_id",
                "name",
                "start",
                "end",
                "cost_cny",
                "transport_from_previous_min",
                "reason",
                "evidence_ids"
              ],
              "properties": {
                "item_id": {"type": "string", "minLength": 1},
                "poi_id": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
                "end": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
                "cost_cny": {"type": "number", "minimum": 0},
                "transport_from_previous_min": {"type": "integer", "minimum": 0},
                "reason": {"type": "string"},
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "estimated_total_cost_cny": {"type": "number", "minimum": 0},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}}
  }
}
